rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSproutMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'allenkevinc@gmail.com',
          'meganec96@gmail.com'
        ];
    }

    match /sproutHouseholds/shared/{document=**} {
      allow read, write: if isSproutMember();
    }
  }
}
